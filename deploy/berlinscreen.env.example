# BerlinScreen environment overrides — example file.
#
# Copy this to /etc/berlinscreen.env on the Pi and fill in real values.
# install.sh will do this automatically with mode 600 if the file is missing.
# Never commit /etc/berlinscreen.env or its real contents.

# --- Deutsche Bahn FaSta API (S-Bahn elevator/escalator status) ---
# Register at https://developers.deutschebahn.com, create an app, subscribe
# it to the FaSta API, then paste the credentials here.
# DB_CLIENT_ID=
# DB_FASTA_API_KEY=

# --- Adhan ---
# ADHAN_FAJR=1                # 1 to enable Fajr Adhan; 0 (default) to mute Fajr
# QUIET_HOURS_START=22        # hour after which playback uses QUIET_VOLUME_PCT
# QUIET_HOURS_END=7
# QUIET_VOLUME_PCT=50
# NORMAL_VOLUME_PCT=90

# --- Screen ---
# SCREEN_CONTROL=1            # 0 to disable auto screen-off
# SCREEN_OFF_HOUR=23
# SCREEN_ON_HOUR=6

# --- Facility / transit ---
# WATCHED_LINES=U6,U7,U8
